{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "diagnostics": false,
        "tsconfig": {
          "allowJs": true
        }
      }
    ]
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^app/(.*)$": "<rootDir>/../src/app/$1",
    "^configs/(.*)$": "<rootDir>/../src/configs/$1",
    "^shared/(.*)$": "<rootDir>/../src/shared/$1",
    "^modules/(.*)$": "<rootDir>/../src/modules/$1",
    "@runtime/prisma-client": "<rootDir>/../prisma/runtime/client",
    "@runtime/prisma-browser": "<rootDir>/../prisma/runtime/browser",
    "lib/nest-auth": "<rootDir>/../libs/nest-auth/src",
    "lib/nest-auth/(.*)": "<rootDir>/../libs/nest-auth/src/$1",
    "lib/nest-core": "<rootDir>/../libs/nest-core/src",
    "lib/nest-core/(.*)": "<rootDir>/../libs/nest-core/src/$1",
    "lib/nest-web": "<rootDir>/../libs/nest-web/src",
    "lib/nest-web/(.*)": "<rootDir>/../libs/nest-web/src/$1",
    "lib/nest-prisma": "<rootDir>/../libs/nest-prisma/src",
    "lib/nest-prisma/(.*)": "<rootDir>/../libs/nest-prisma/src/$1",
    "^tools/(.*)$": "<rootDir>/../src/tools/$1"
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!\\.pnpm|p-queue|p-timeout|eventemitter3|otplib|@otplib|@scure|@noble)"
  ]
}
