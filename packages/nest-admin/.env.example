# Optional: defaults to /api/admin (same origin). Set for a remote API, e.g. http://localhost:3000/api/admin
VITE_API_BASE_URL=
VITE_APP_VERSION=1.0.0
VITE_APP_TINYMCE_KEY=
# Optional: HMAC key for signed requests, used only when the API answers x-security-mode: signature
# (admin routes only need x-nonce + x-timestamp). It ships in the public bundle: not a secret.
VITE_REQUEST_SECURITY_KEY=
