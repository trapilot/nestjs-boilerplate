generator client {
  provider = "prisma-client"
  output   = "./runtime"
}

datasource db {
  provider = "postgresql"
}

model Setting {
  id          Int       @id @default(autoincrement())
  type        String
  name        String?
  code        String    @unique()
  description String?
  group       String    @default("SYSTEM")
  value       String
  refer       String?
  isVisible   Boolean?  @default(true)
  createdBy   Int?
  updatedBy   Int?
  deletedBy   Int?
  deletedAt   DateTime?
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt

  @@index([type])
  @@map("settings")
}

model QueueCursor {
  name      String
  version   Int      @default(1)
  lastId    Int?
  batchId   Int?
  updatedAt DateTime @updatedAt

  @@id([name, version])
  @@map("queue_cursors")
}

model QueueJob {
  id          Int           @id @default(autoincrement())
  jobName     String
  jobHash     String?
  version     Int           @default(1)
  payload     Json?
  status      EnumJobStatus @default(PENDING)
  startAt     DateTime
  thresholdAt DateTime
  retryCount  Int           @default(0)
  maxRetries  Int           @default(3)
  priority    Int           @default(5)
  persistent  Boolean       @default(false)
  lastError   String?
  heartbeatAt DateTime?
  lockedAt    DateTime?
  lockedBy    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([jobHash])
  @@index([status, id])
  @@index([status, heartbeatAt])
  @@index([status, thresholdAt])
  @@index([status, startAt, priority])
  @@map("queue_jobs")
}

model QueueJobArchive {
  id         Int      @id @default(autoincrement())
  originalId Int
  jobName    String
  payload    Json?
  result     Json?
  retryCount Int
  finishedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([jobName])
  @@map("queue_job_archives")
}

model QueueJobFailure {
  id         Int      @id @default(autoincrement())
  originalId Int
  jobName    String
  payload    Json?
  retryCount Int
  lastError  String?
  failedAt   DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([jobName])
  @@map("queue_job_failures")
}

model ApiKey {
  id           Int            @id @default(autoincrement())
  type         EnumApiKeyType @default(CLIENT)
  name         String
  key          String
  hash         String
  isDeprecated Boolean?       @default(false)
  isActive     Boolean?       @default(true)
  startDate    DateTime?
  untilDate    DateTime?
  createdAt    DateTime?      @default(now())
  updatedAt    DateTime?      @updatedAt

  @@map("api_keys")
}

model AppVersion {
  id        Int              @id @default(autoincrement())
  type      EnumPlatformType @unique @default(IOS)
  name      String
  version   String
  url       String?
  isForce   Boolean?         @default(false)
  isActive  Boolean?         @default(true)
  createdAt DateTime?        @default(now())
  updatedAt DateTime?        @updatedAt

  @@map("app_versions")
}

model Country {
  id         Int       @id @default(autoincrement())
  name       String
  alpha2Code String
  alpha3Code String
  phoneCode  Json
  continent  String
  timezone   String
  isActive   Boolean?  @default(true)
  isVisible  Boolean?  @default(true)
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
  createdBy  Int?
  updatedBy  Int?

  customers Customer[]
  districts District[]

  @@unique(fields: [alpha2Code])
  @@unique(fields: [alpha3Code])
  @@index(fields: [name, alpha2Code, alpha3Code, continent, createdAt])
  @@index(fields: [createdAt])
  @@map("countries")
}

model District {
  id        Int       @id @default(autoincrement())
  countryId Int?
  name      Json?
  isActive  Boolean?  @default(true)
  isVisible Boolean?  @default(true)
  createdAt DateTime? @default(now())
  updatedAt DateTime  @updatedAt

  country Country? @relation(fields: [countryId], references: [id])

  customers Customer[]

  @@map("districts")
}

model Notification {
  id          Int                     @id @default(autoincrement())
  refId       Int?
  refType     String?
  channel     EnumNotificationChannel @default(EMAIL)
  type        EnumNotificationMethod  @default(TEXT)
  title       Json
  description Json?
  content     Json?
  isActive    Boolean                 @default(true)
  createdAt   DateTime?               @default(now())
  updatedAt   DateTime?               @updatedAt
  createdBy   Int?
  updatedBy   Int?

  createdByUser User? @relation("createdByUser", fields: [createdBy], references: [id])
  updatedByUser User? @relation("updatedByUser", fields: [updatedBy], references: [id])

  pushes                Push[]
  customerNotifications CustomerNotification[]

  @@map("notifications")
}

model Push {
  id             Int             @id @default(autoincrement())
  notificationId Int
  type           EnumPushType    @default(ONCE)
  status         EnumPushStatus? @default(PENDING)
  year           Int?
  month          Int?
  day            Int?
  weekday        Int?
  hour           Int?
  minute         Int?
  second         Int?
  sinceDate      DateTime?
  untilDate      DateTime?
  retryCount     Int?            @default(0)
  maxRetries     Int             @default(3)
  lastError      String?
  isImmediate    Boolean?        @default(false)
  isActive       Boolean?        @default(true)
  startAt        DateTime?
  expiresAt      DateTime?
  createdAt      DateTime?       @default(now())
  updatedAt      DateTime?       @updatedAt
  createdBy      Int?
  updatedBy      Int?

  createdByUser User? @relation("createdByUser", fields: [createdBy], references: [id])
  updatedByUser User? @relation("updatedByUser", fields: [updatedBy], references: [id])

  notification Notification @relation(fields: [notificationId], references: [id])

  pushCustomers     CustomerPush[]
  pushNotifications CustomerNotification[]

  @@index([status, retryCount])
  @@map("pushes")
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String
  type        EnumRoleType @default(USER)
  description String?
  isActive    Boolean?     @default(true)
  deletedAt   DateTime?
  createdAt   DateTime?    @default(now())
  updatedAt   DateTime?    @updatedAt
  createdBy   Int?
  updatedBy   Int?

  pivotPolicies RolesPolicies[]
  users         User[]          @relation("UserRole")

  @@unique([name])
  @@index([type, createdAt])
  @@map("roles")
}

model Policy {
  id        Int       @id @default(autoincrement())
  title     Json?
  context   String?
  path      String?
  subject   String    @unique
  bitwise   Int?      @default(0)
  sorting   Int?      @default(0)
  isVisible Boolean?  @default(true)
  isActive  Boolean?  @default(true)
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
  createdBy Int?
  updatedBy Int?

  createdByUser User? @relation("createdByUser", fields: [createdBy], references: [id])
  updatedByUser User? @relation("updatedByUser", fields: [updatedBy], references: [id])

  pivotRoles RolesPolicies[]

  @@map("policies")
}

model RolesPolicies {
  policyId   Int
  roleId     Int
  bitwise    Int?      @default(0)
  assignedBy Int?
  assignedAt DateTime? @default(now())

  policy Policy @relation(fields: [policyId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([policyId, roleId])
  @@map("_roles_policies")
}

model User {
  id              Int       @id @default(autoincrement())
  type            String?
  roleId          Int?
  email           String?   @unique
  phone           String?
  name            String?
  avatar          String?
  address         String?
  phoneRegion     String?
  phoneNumber     String?
  loginToken      String?
  loginDate       DateTime?
  password        String
  passwordConfirm String?
  passwordAttempt Int?      @default(0)
  passwordExpired DateTime?
  signUpFrom      String?
  isActive        Boolean?  @default(true)
  isDeleted       Boolean?  @default(false)
  isEmailVerified Boolean?  @default(true)
  isPhoneVerified Boolean?  @default(true)
  deletedAt       DateTime?
  createdAt       DateTime? @default(now())
  updatedAt       DateTime? @updatedAt
  createdBy       Int?
  updatedBy       Int?

  createdUserTwoFactor     UserTwoFactor[]     @relation("createdByUser")
  updatedUserTwoFactor     UserTwoFactor[]     @relation("updatedByUser")
  createdCustomerTwoFactor CustomerTwoFactor[] @relation("createdByUser")
  updatedCustomerTwoFactor CustomerTwoFactor[] @relation("updatedByUser")
  createdPolicies          Policy[]            @relation("createdByUser")
  updatedPolicies          Policy[]            @relation("updatedByUser")
  createdNotifications     Notification[]      @relation("createdByUser")
  updatedNotifications     Notification[]      @relation("updatedByUser")
  createdPushes            Push[]              @relation("createdByUser")
  updatedPushes            Push[]              @relation("updatedByUser")
  createdContents          Content[]           @relation("createdByUser")
  updatedContents          Content[]           @relation("updatedByUser")
  createdCustomers         Customer[]          @relation("createdByUser")
  updatedCustomers         Customer[]          @relation("updatedByUser")
  deletedCustomers         Customer[]          @relation("deletedByUser")
  createdActivityLogs      ActivityLog[]       @relation("ActivityLogCreatedBy")

  twoFactor     UserTwoFactor?
  activityLogs  ActivityLog[]      @relation("UserActivityLogs")
  sessions      UserSession[]
  verifications UserVerification[]
  role          Role?              @relation("UserRole", fields: [roleId], references: [id])

  @@index([roleId])
  @@map("users")
}

model UserTwoFactor {
  id            Int       @id @default(autoincrement())
  userId        Int       @unique()
  secret        String?
  iv            String?
  backupCodes   Json
  enabled       Boolean   @default(false)
  requiredSetup Boolean   @default(false)
  confirmedAt   DateTime?
  lastUsedAt    DateTime?
  attempt       Int       @default(0)
  createdAt     DateTime? @default(now())
  updatedAt     DateTime? @updatedAt
  createdBy     Int?
  updatedBy     Int?

  createdByUser User? @relation("createdByUser", fields: [createdBy], references: [id])
  updatedByUser User? @relation("updatedByUser", fields: [updatedBy], references: [id])

  user User @relation(fields: [userId], references: [id])

  @@map("user_two_factors")
}

model UserSession {
  id        Int       @id @default(autoincrement())
  userId    Int
  jti       String
  ipAddress String
  userToken String    @unique()
  userAgent Json
  expiredAt DateTime
  revokedAt DateTime?
  isRevoked Boolean   @default(false)
  createdAt DateTime? @default(now())
  createdBy Int?
  updatedAt DateTime? @updatedAt
  updatedBy Int?

  user User @relation(fields: [userId], references: [id])

  @@index(fields: [userId])
  @@index(fields: [userId, isRevoked, expiredAt])
  @@index(fields: [createdAt])
  @@index(fields: [updatedAt])
  @@map("user_sessions")
}

model UserVerification {
  id         Int                     @id @default(autoincrement())
  channel    EnumVerificationChannel
  type       EnumVerificationMethod
  code       String
  userId     Int?
  phone      String?
  email      String?
  attempts   Int?                    @default(1)
  isActive   Boolean?                @default(true)
  isVerified Boolean?                @default(false)
  verifiedAt DateTime?
  isExpired  Boolean                 @default(false)
  expiresAt  DateTime?
  createdAt  DateTime?               @default(now())
  updatedAt  DateTime?               @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@map("user_verifications")
}

model Customer {
  id              Int       @id @default(autoincrement())
  refId           String? // ID to integrate with other system
  countryId       Int?
  districtId      Int?
  email           String?   @unique
  name            String?
  citizenId       String?
  appleId         String?   @unique
  phone           String?   @unique
  locale          String?
  gender          String?
  address         String?
  avatar          String?
  birthDate       DateTime?
  phoneRegion     String?
  phoneNumber     String?
  birthYear       Int?
  birthMonth      Int?
  birthDay        Int?
  loginToken      String?
  loginDate       DateTime?
  password        String?
  passwordAttempt Int?      @default(0)
  passwordExpired DateTime?
  isActive        Boolean?  @default(true)
  isVisible       Boolean?  @default(true)
  isDeleted       Boolean?  @default(false)
  isPushable      Boolean?  @default(true)
  isNotifiable    Boolean?  @default(true)
  isPromotable    Boolean?  @default(true)
  isEmailVerified Boolean?  @default(false)
  isPhoneVerified Boolean?  @default(false)
  promoViaApp     Boolean?  @default(false)
  promoViaEmail   Boolean?  @default(false)
  deletedAt       DateTime?
  createdAt       DateTime? @default(now())
  updatedAt       DateTime? @updatedAt
  deletedBy       Int?
  createdBy       Int?
  updatedBy       Int?

  createdByUser User? @relation("createdByUser", fields: [createdBy], references: [id])
  updatedByUser User? @relation("updatedByUser", fields: [updatedBy], references: [id])
  deletedByUser User? @relation("deletedByUser", fields: [deletedBy], references: [id])

  twoFactor CustomerTwoFactor?
  district  District?          @relation(fields: [districtId], references: [id])
  country   Country?           @relation(fields: [countryId], references: [id])

  deletions     CustomerDeletion[]
  sessions      CustomerSession[]
  activityLogs  ActivityLog[]
  devices       CustomerDevice[]
  verifications CustomerVerification[]
  notifications CustomerNotification[]
  pushes        CustomerPush[]

  @@index([isActive, email])
  @@index([isActive, phone])
  @@map("customers")
}

model CustomerTwoFactor {
  id            Int       @id @default(autoincrement())
  customerId    Int       @unique()
  secret        String?
  iv            String?
  backupCodes   Json
  enabled       Boolean   @default(false)
  requiredSetup Boolean   @default(false)
  confirmedAt   DateTime?
  lastUsedAt    DateTime?
  attempt       Int       @default(0)
  createdAt     DateTime? @default(now())
  updatedAt     DateTime? @updatedAt
  createdBy     Int?
  updatedBy     Int?

  createdByUser User? @relation("createdByUser", fields: [createdBy], references: [id])
  updatedByUser User? @relation("updatedByUser", fields: [updatedBy], references: [id])

  customer Customer @relation(fields: [customerId], references: [id])

  @@map("customer_two_factors")
}

model CustomerDeletion {
  id         Int       @id @default(autoincrement())
  customerId Int
  title      String?
  createdAt  DateTime? @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@map("customer_deletions")
}

model CustomerSession {
  id         Int       @id @default(autoincrement())
  customerId Int
  jti        String
  ipAddress  String
  userToken  String    @unique()
  userAgent  Json
  expiredAt  DateTime
  revokedAt  DateTime?
  isRevoked  Boolean   @default(false)
  createdAt  DateTime? @default(now())
  createdBy  Int?
  updatedAt  DateTime? @updatedAt
  updatedBy  Int?

  customer Customer @relation(fields: [customerId], references: [id])

  @@index(fields: [customerId])
  @@index(fields: [customerId, isRevoked, expiredAt])
  @@index(fields: [createdAt])
  @@index(fields: [updatedAt])
  @@map("customer_sessions")
}

model CustomerDevice {
  id         Int       @id @default(autoincrement())
  customerId Int
  type       String?
  model      String?
  version    String?
  token      String?
  isActive   Boolean?  @default(true)
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([customerId, token])
  @@index([customerId])
  @@map("customer_devices")
}

model CustomerVerification {
  id         Int                     @id @default(autoincrement())
  channel    EnumVerificationChannel
  type       EnumVerificationMethod
  code       String
  customerId Int?
  phone      String?
  email      String?
  attempts   Int?                    @default(1)
  isActive   Boolean?                @default(true)
  isVerified Boolean?                @default(false)
  verifiedAt DateTime?
  isExpired  Boolean                 @default(false)
  expiresAt  DateTime?
  createdAt  DateTime?               @default(now())
  updatedAt  DateTime?               @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("customer_verifications")
}

model CustomerNotification {
  id             Int       @id @default(autoincrement())
  customerId     Int
  notificationId Int?
  pushId         Int?
  title          String?
  body           String
  data           Json?
  refId          Int?
  refType        String?
  isRead         Boolean?  @default(false)
  pushedAt       DateTime?
  seenAt         DateTime?
  readAt         DateTime?
  deletedAt      DateTime?
  createdAt      DateTime? @default(now())

  customer     Customer      @relation(fields: [customerId], references: [id])
  notification Notification? @relation(fields: [notificationId], references: [id])
  push         Push?         @relation(fields: [pushId], references: [id])

  @@index([customerId, pushedAt, isRead])
  @@map("customer_notifications")
}

model CustomerPush {
  id          Int            @id @default(autoincrement())
  customerId  Int
  pushId      Int
  deviceToken String
  status      EnumPushResult
  errorCode   String?

  pushedAt  DateTime
  createdAt DateTime? @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  push     Push     @relation(fields: [pushId], references: [id])

  @@index([customerId, createdAt])
  @@index([customerId, pushId])
  @@map("customer_pushes")
}

model Content {
  id        Int       @id @default(autoincrement())
  type      String
  title     Json?
  content   Json?
  thumbnail String?
  sorting   Int?      @default(0)
  isVisible Boolean?  @default(true)
  isActive  Boolean?  @default(true)
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
  createdBy Int?
  updatedBy Int?

  createdByUser User? @relation("createdByUser", fields: [createdBy], references: [id])
  updatedByUser User? @relation("updatedByUser", fields: [updatedBy], references: [id])

  @@map("contents")
}

// Audit trail of user behaviour (see modules/activity-log and CLAUDE.md).
// A row belongs to exactly one owner: an admin staff User (userId) or a Customer (customerId);
// the migration adds a CHECK constraint for that. createdBy is the admin User who performed
// the action, or the owner itself for a staff User acting on itself, or null when a customer
// acted on itself or the system did.
model ActivityLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  customerId  Int?
  action      String // EnumActivityLogAction (TS enum in modules/activity-log)
  description String
  ipAddress   String?
  userAgent   Json?
  metadata    Json?
  createdAt   DateTime @default(now())
  createdBy   Int?

  user          User?     @relation("UserActivityLogs", fields: [userId], references: [id], onDelete: Restrict)
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdByUser User?     @relation("ActivityLogCreatedBy", fields: [createdBy], references: [id])

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([customerId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([createdBy, createdAt(sort: Desc)])
  @@map("activity_logs")
}

enum EnumJobStatus {
  PENDING
  RUNNING
  FAILED
}

enum EnumApiKeyType {
  SYSTEM
  CLIENT
  DEFAULT
}

enum EnumPlatformType {
  IOS
  AOS
  WEB
}

enum EnumVerificationChannel {
  SMS
  EMAIL
}

enum EnumVerificationMethod {
  SIGN_UP
  RESET_PASSWORD
  FORGOT_PASSWORD
  CHANGE_PASSWORD
}

enum EnumNotificationChannel {
  SMS
  EMAIL
  WHATSAPP
}

enum EnumNotificationMethod {
  TEXT
  REFERENCE
}

enum EnumPushType {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum EnumPushStatus {
  PENDING
  RUNNING
  COMPLETED
  CANCELED
}

enum EnumPushResult {
  SENT
  FAILED
  INVALID
}

enum EnumRoleType {
  SUPER_ADMIN
  ADMIN
  USER
}
